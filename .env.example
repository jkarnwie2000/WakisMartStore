# ─── Stripe (use TEST keys during development: sk_test_… / pk_test_…) ───
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Database (PostgreSQL, e.g. Neon) ───
# Pooled connection used by the app, and the direct connection used by Prisma CLI (db push).
# On Vercel these are added automatically by the Neon integration; locally, run `vercel env pull .env`
# or paste them from the Neon dashboard.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Image uploads ───
# Vercel Blob read-write token. Leave blank locally to save uploads to server/uploads instead.
BLOB_READ_WRITE_TOKEN=

# ─── Order confirmation emails (Resend — https://resend.com) ───
# Leave RESEND_API_KEY blank to disable emails. Without a verified domain, Resend only delivers to
# the email address that owns your Resend account. After verifying your domain, set EMAIL_FROM,
# e.g. EMAIL_FROM="Wakis Mart <orders@yourdomain.com>". Set STORE_EMAIL to receive customer replies.
RESEND_API_KEY=
EMAIL_FROM=

# ─── App URLs / ports ───
# Public storefront URL used for Stripe redirects. On Vercel, set it to your production URL
# (if unset there, the project's production domain is used).
CLIENT_URL=http://localhost:5173
SERVER_PORT=4000

# ─── Auth ───
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Admin account created/updated by the seed script
ADMIN_EMAIL=admin@wakismart.local
ADMIN_PASSWORD=ChangeMe123!

# ─── Store settings (all optional — sensible defaults are used when blank) ───
# Sales-tax rate applied to the order subtotal (0.07 = 7%). Set to your local rate, or 0 to disable.
TAX_RATE=0.07
CURRENCY=usd
DELIVERY_ENABLED=true
# Flat delivery fee in dollars, and the subtotal at which delivery becomes free (0 = never free)
DELIVERY_FEE=7.99
FREE_DELIVERY_THRESHOLD=75
DELIVERY_NOTE=Delivery is available to local addresses. Our team will contact you to confirm your delivery window.
PICKUP_ENABLED=true
PICKUP_INSTRUCTIONS=We will contact you when your order is ready for pickup. Please bring your order number.
# Leave blank until you are ready to publish your real store details
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=
STORE_HOURS=

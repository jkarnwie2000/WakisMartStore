{
  "name": "wakis-mart-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output server.js",
    "start": "node server.js",
    "db:push": "dotenv -e ../.env -- prisma db push",
    "db:seed": "dotenv -e ../.env -- node prisma/seed.js",
    "db:reset": "dotenv -e ../.env -- prisma db push --force-reset && npm run db:seed",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "images": "node prisma/generate-images.js",
    "lint": "eslint .",
    "test": "node tests/run-tests.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "stripe": "^18.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "prisma": "6.19.3"
  }
}
